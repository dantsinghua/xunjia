# Reference only. Integrate into the existing nginx stream context on the gateway.
# Validate there with nginx -t before a normal nginx reload.
stream {
    server {
        listen 50443;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
        proxy_pass its-relay.yingmi.cn:443;
    }
    server {
        listen 11443;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
        proxy_pass web.innodealing.com:443;
    }
    server {
        listen 12443;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
        proxy_pass rest.innodealing.com:443;
    }
    server {
        listen 13443;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
        proxy_pass bosh2.innodealing.com:443;
    }
}
