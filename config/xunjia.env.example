# xunjia-agent deployment configuration - approved field structure.
# Immutable template. The packager initializes editable xunjia.env from this file only.
# chmod 600 after editing. Do not commit filled secrets or transfer them with updates.
#
# ARM64 fresh deployment. Site endpoint metadata follows the supplied NJCB document;
# verify the addresses at installation time. Passwords and keys remain empty.
#   Application prefix: /home/xunjia
#   User authorization and pause state govern command dispatch.

# Same OceanBase server/tenant as NJCB, a separate xunjia_business database.
# URL-encode username/password: @ becomes %40, # becomes %23, : becomes %3A.
# The documented tenant username is deposit%40deposit_mysql%23nylc01.
# fresh-install --apply CLEARS this database before creating the current tables.
XUNJIA_DATABASE_URL='oceanbase://REPLACE_DATABASE_USER:REPLACE_DATABASE_PASSWORD@158.188.2.206:3306/xunjia_business'
XUNJIA_HOST='0.0.0.0'
XUNJIA_PORT='18770'
XUNJIA_WEB_DIST=''
XUNJIA_STATE_DIR=''

# Background lifecycle for intake, analysis, dispatch and reconciliation.
XUNJIA_RUN_BACKGROUND='1'
XUNJIA_QUOTE_SOURCE='qb'
# Current HTTPS/mTLS institution connection. Set STATE_DIR explicitly for direct startup.
# Set INSTITUTION_CONFIG to the private JSON described by institution-connection.example.json.
# The JSON references auth_file and client certificate/key paths; remote paths are built in.
# Required for the IM channel: /home/xunjia/config/institution-connection.json.
# Start from institution-connection.example.json and use newly supplied credentials.
XUNJIA_INSTITUTION_CONFIG=''
# Nginx stream TCP relay. Original Host/SNI/TLS/mTLS remain unchanged.
# its-relay:443 -> 50443; rest:443 -> 12443; bosh2:443 -> 13443; web:443 -> 11443.
XUNJIA_EGRESS_GATEWAY='172.26.64.36'

# Two published V2.2 Chatflows, with their ordinary App API Keys.
# This implementation uses /v1/chat-messages (NOT /v1/workflows/run).
# Fill the Dify App API Key; this is NOT a console/admin key.
XUNJIA_DIFY_URL='http://158.188.1.161/v1'
XUNJIA_DIFY_ANALYSIS_APP_KEY=''
XUNJIA_DIFY_REPLY_APP_KEY=''
# Per-request HTTP deadline (1..300); tune with the measured model profile.
XUNJIA_DIFY_TIMEOUT_SECONDS='90'
# Total stage budget includes bounded public-tool and private-history rounds.
# The lease is this budget plus 30 seconds; the maximum stage budget is 540.
XUNJIA_DIFY_STAGE_BUDGET_SECONDS='150'
# Required: /home/xunjia/config/aggregation-profile.measured.json for this prefix.
# This supplied measurement is a baseline; remeasure if the site model differs.
XUNJIA_AGGREGATION_PROFILE=''
XUNJIA_BOND_CONTEXT_MESSAGES='20'
XUNJIA_REFERENCE_CONFIG=''
# Retry current-day ChinaBond recovery even after rollover; Inno updates also trigger immediately.
XUNJIA_VALUATION_REFRESH_SECONDS='2'

# Local application authentication; XUNJIA_AUTH_SECRET is the actual code variable.
# The SSO secret is agreed with your portal SSO integration. These are NOT Dify keys.
XUNJIA_SSO_SECRET=''
XUNJIA_AUTH_SECRET=''

# V2.2 uses ordinary App API Keys and no private callback/Tool tokens.

# Business-specific optional settings.
XUNJIA_ALLOWED_ORIGINS=''

# Empty WEB_DIST / STATE_DIR use the actual install prefix automatically.
# Filled configuration and referenced JSON/certificates live in PREFIX/config/.
# Installer does not execute shell substitutions from this file. Use literal values only.

# Development key-entry form uses the portal SSO proof contract; keep disabled at customer deployment.
XUNJIA_AUTH_DEV_LOGIN=0
XUNJIA_DEV_USER_NAME=
XUNJIA_DEV_NICK_NAME=

# Innodealing shared quote settings. Every signed-in user can configure and operate the source.
# Internet access uses the stream gateway above. Never disable TLS verification.
QB_CONFIG_DIR=
XUNJIA_QUOTE_AUTOSTART=0
# Empty QB_MYSQL fields inherit this NEW env's business DSN in the installer/runtime.
# Fresh deployment requires the quote tables to use that same xunjia_business database.
QB_MYSQL_HOST=
QB_MYSQL_PORT=
QB_MYSQL_USER=
QB_MYSQL_PASSWORD=
QB_MYSQL_DB=
XUNJIA_QUOTE_CACHE=
# Missing dictionary IDs are fetched from the authenticated real Innodealing batch API.
# Optional private external JSON/MySQL dictionary source; absent means Innodealing only.
QB_DICTIONARY_SOURCE='innodealing'
QB_DICTIONARY_CONFIG=''
QB_FE_VER='14417'

# Optional absolute shared QT connection config; otherwise managed on the collection page.
XUNJIA_QT_CONFIG=
