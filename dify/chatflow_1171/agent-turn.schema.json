{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "conversation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "source_message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object"
      }
    },
    "proposed_actions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SOCIAL_REPLY",
              "CLARIFY_BOND",
              "ASK_QUOTE",
              "COUNTER",
              "WAIT",
              "REQUEST_HANDOFF"
            ]
          }
        }
      }
    },
    "public_message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "trader_view": {
      "type": "object"
    },
    "memory_patch": {
      "type": [
        "object",
        "null"
      ]
    },
    "history_request": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "turn_id",
    "conversation_epoch",
    "source_message_id",
    "observations",
    "proposed_actions",
    "public_message",
    "trader_view",
    "memory_patch",
    "history_request",
    "validation_ref"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
